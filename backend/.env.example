DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=local-only-replace-in-production-7vQ2!mK9-pR4@xT8-zN6&wH3
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO
FORGE_ENVIRONMENT=development
FORGE_FRONTEND_ORIGIN=http://127.0.0.1:5175
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me-for-local-development-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_SSLMODE=

# Optional alternative for managed PostgreSQL providers such as Supabase.
# Use either DATABASE_URL or the POSTGRES_* values above.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

WAIT_FOR_DATABASE=true
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=false

# Authentication protection (per process with Django's default local cache).
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Required by config.settings.production.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey-or-user
# EMAIL_HOST_PASSWORD=replace-me
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Forge <no-reply@example.com>
